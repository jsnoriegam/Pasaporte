FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
        python3-pip \
        libpython3.10 \
        build-essential \
        patchelf \
        file \
        wget \
        ca-certificates \
        squashfs-tools \
        zsync \
        desktop-file-utils \
        libgl1 \
        libegl1 \
        libxkbcommon0 \
        libxkbcommon-x11-0 \
        libxcomposite1 \
        libxdamage1 \
        libxrandr2 \
        libxi6 \
        libxtst6 \
        libnss3 \
        libnspr4 \
        libasound2 \
        libgbm1 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-render-util0 \
        libxcb-xinerama0 \
        libxcb-xkb1 \
        libxcb-cursor0 \
        libxcb-shape0 \
        libxkbfile1 \
        libpulse0 \
        libdbus-1-3 \
        libfontconfig1 \
        libfreetype6 \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q \
        https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage \
        -O /usr/local/bin/appimagetool \
    && chmod +x /usr/local/bin/appimagetool

WORKDIR /src
